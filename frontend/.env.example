# Local Vite only. The browser still calls /api; Vite forwards those requests
# to this staging API Gateway stage origin.
# API_PROXY_TARGET=https://example.execute-api.us-east-1.amazonaws.com/v1
#
# Do not set VITE_PUBLIC_DIR. External static asset folders should be symlinked
# into frontend/public so Vite also copies root files like favicon.svg,
# robots.txt, sitemap.xml, _headers, and _redirects.
# VITE_ARTWORK_ASSET_BASE_URL=https://d2oephvbntzgfl.cloudfront.net
