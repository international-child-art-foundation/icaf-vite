/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=31536000, immutable

/documents/*
  Cache-Control: public, max-age=3600

/data/*
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/documents/2026WCF.pdf
  Content-Disposition: inline; filename="2026WCF.pdf"

/documents/Cultural_Exposition.pdf
  Content-Disposition: inline; filename="Cultural_Exposition.pdf"

# Cloudflare automatically marks pages.dev previews as noindex, but that header
# does not carry over to a custom domain attached to the staging branch.
https://staging.icaf.org/*
  X-Robots-Tag: noindex, nofollow
